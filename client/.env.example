# Both are optional for local development — the app falls back to relative
# URLs ('/api' and same-origin sockets), which Vite's dev proxy resolves to
# localhost:5050 (see vite.config.js). Set these only for a production deploy
# where the frontend and backend are separate origins (e.g. two Railway
# services), pointing at the backend's real public URL.

# VITE_API_URL=https://your-backend.up.railway.app/api
# VITE_SOCKET_URL=https://your-backend.up.railway.app

# Optional: Google Maps JavaScript API key for interactive map visualization on /nearby.
# If omitted or invalid, /nearby gracefully displays a coordinate summary & fallback panel
# without breaking discovery, matching, search, or RFQ functionality.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
