{
  "category": "tablet",
  "templateVersion": "1.0",
  "description": "Baseline inspection parameters for tablet.",
  "extends": "electronics",
  "mandatoryParameters": [
    "display_condition",
    "touchscreen",
    "back_body",
    "rear_camera",
    "front_camera",
    "speakers_output",
    "microphone",
    "charging",
    "wifi",
    "bluetooth",
    "physical_buttons",
    "account_lock",
    "boot_os"
  ],
  "conditionalParameters": [
    "face_unlock",
    "fingerprint",
    "stylus",
    {
      "param": "cellular",
      "when": {
        "hasCellular": true
      }
    },
    {
      "param": "imei",
      "when": {
        "hasCellular": true
      }
    }
  ],
  "excludeParameters": [
    "function_general",
    "power_supply_safety"
  ],
  "attributeDefaults": {
    "hasBattery": true,
    "hasTouchscreen": true,
    "hasCamera": true
  },
  "forbiddenTerms": [
    "hinge",
    "vehicle",
    "lamp hours"
  ]
}
