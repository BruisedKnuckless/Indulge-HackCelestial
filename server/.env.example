# Runtime Environment
NODE_ENV=development
PORT=5050

# Database Configuration
# In development/test, leave unset to use an in-memory database.
# In production, MONGODB_URI is MANDATORY and cannot be omitted.
MONGODB_URI=mongodb://localhost:27017/indulge

# Authentication & Security
# Change to a strong, high-entropy secret in production (minimum 16 characters).
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES=7d

# CORS & Client Allowlist
# In production, provide a comma-separated list of allowed origins. Do NOT use '*'.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Platform Administration
# The admin account created/updated at every boot. Admins are separate from
# business accounts and sign in at /admin/login. Production refuses the demo
# password 'indulge123'.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_NAME=Platform Admin

# Cloudinary Media Storage (Optional)
# If unset, the server gracefully uses sanitized local disk storage for resource images.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Optional / Sandbox)
# Options: 'simulated' (default for dev/test) or 'production' / 'razorpay' / 'stripe'
PAYMENT_GATEWAY_PROVIDER=simulated
PAYMENT_GATEWAY_KEY_ID=your_gateway_key_or_sandbox_key
PAYMENT_GATEWAY_SECRET=your_gateway_secret
PAYMENT_WEBHOOK_SECRET=your_gateway_webhook_signing_secret

# RFQ smart intake — Nugen-aligned model, called through LangChain (src/ml/rfq)
# With no key the intake box still works on the rule parser.
NUGEN_API_KEY=
# Base model to align (npm run rfq:align lists what your account can align)
NUGEN_BASE_MODEL=llama-v3p2-3b-reasoning
# Override the aligned model id recorded in src/ml/rfq/nugen-model.json
NUGEN_RFQ_MODEL=
# auto (on when NUGEN_API_KEY is set) | on | off
RFQ_AI=auto
RFQ_AI_TIMEOUT_MS=15000
# Below this Nugen confidence (0-100), filled fields are flagged for checking
RFQ_MIN_CONFIDENCE=40
