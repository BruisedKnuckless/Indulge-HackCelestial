# Leave MONGO_URI unset to run against an auto-seeded in-memory MongoDB.
# MONGO_URI=mongodb://localhost:27017/indulge

PORT=5050
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173

# ── Admin console ──────────────────────────────────────────────────────────
# Comma-separated emails of existing accounts that get the platform console
# at /admin. Platform admin is deliberately NOT a field on User: every account
# is both provider and seeker by context, so administration is a property of
# the deployment, not of the business record.
#
# REQUIRED IN PRODUCTION. Unset + NODE_ENV=production resolves to an empty
# allowlist, which locks the console (404 on /api/admin) rather than falling
# back to the seeded demo account — that account's password is public, so the
# fallback would make the whole platform administrable by anyone. Locally, with
# NODE_ENV unset, it does fall back to ops@grandorchid.in for convenience.
#
# The API logs whether the console is enabled or locked at startup, including
# which variable it read. ADMIN_EMAIL (singular) is accepted as an alias, so a
# plural typo does not silently lock the console; if both are set, the plural
# wins.
ADMIN_EMAILS=ops@grandorchid.in

# ── AI / Chatbot layer ─────────────────────────────────────────────────────────
# Server-side only — NEVER expose this to the React client or commit to git.
# The AI routes check for this key at runtime; the chatbot gracefully degrades
# (returns 503) if the key is missing rather than crashing the server.
#
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
