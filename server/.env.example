# Leave MONGO_URI unset to run against an auto-seeded in-memory MongoDB.
# MONGO_URI=mongodb://localhost:27017/indulge

PORT=5050
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173

# Admin console allowlist — comma-separated emails of existing accounts.
# Platform admin is deliberately NOT a field on User: every account is both
# provider and seeker by context, so administration is a property of the
# deployment. Unset outside production falls back to the demo login below;
# unset IN production locks /api/admin entirely.
ADMIN_EMAILS=ops@grandorchid.in
